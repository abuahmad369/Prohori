# Copy to .env.local and fill in. Never commit real values.

# Public address of the app, used for payment callback URLs (no trailing slash).
APP_URL=http://localhost:3000

# Optional: a GitHub token raises the limit on scanning public repositories (60 an hour without one).
GITHUB_TOKEN=

# Set to "off" to skip the OSV.dev vulnerability lookup during scans.
PROHORI_OSV=

# Simulated payment gateway. Signing secret is random per process when empty.
MOCK_GATEWAY_SECRET=
# The simulated gateway is disabled in production builds unless this is "true".
ALLOW_MOCK_PAYMENTS=

# SSLCommerz (bKash, Nagad, Rocket and local cards). Leave empty to use the simulated gateway.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# "false" switches from the sandbox to live payments.
SSLCOMMERZ_SANDBOX=true
